q1] FACTORIAL OF TWO NUMBER :-

#include <iostream>
using namespace std;

long long factorial(int n) {
    long long fact = 1;
    for(int i = 1; i <= n; i++) {
        fact *= i;
    }
    return fact;
}

int main() {
    int a, b;
    cout << "Enter two numbers: ";
    cin >> a >> b;

    cout << "Factorial of " << a << " = " << factorial(a) << endl;
    cout << "Factorial of " << b << " = " << factorial(b) << endl;

    return 0;
}

